# any-proxy 部署配置示例
#
#   cp .env.example .env
#   vim .env
#   ./deploy.sh
#
# 取值优先级：命令行参数 > shell 环境变量 > 本文件 > 脚本默认值。
# docker compose 也会自动读取同目录的 .env。

# ---- 必填 ----

# 域名。需已把 A/AAAA 记录指向本机公网 IP，且 80/443 可从公网访问。
# Let's Encrypt 不为 IP 签发证书，必须是真实域名。
DOMAIN=proxy.example.com

# ---- 访问控制（全部留空 = 公网开放代理）----

# 放行的目标 host，逗号分隔；`.example.com` 形式匹配其子域。
# 留空 = 不限制，任何人都能通过你的代理访问任意公网地址，带宽算你的。
# 强烈建议按实际用途收紧，例如：
#   ALLOW_TARGETS=api.github.com,.your-api.com
ALLOW_TARGETS=

# 放行的目标端口，逗号分隔。留空 = 不限制（1-65535，实例可被用于端口扫描）。
# 只代理常规 HTTP(S) API 的话填 80,443 即可。
ALLOW_PORTS=

# 共享令牌。设置后所有请求需带 header `X-Proxy-Token: <值>`，该 header 在
# 转发给上游前会被删除。生成：openssl rand -hex 16
# 注意：纯前端场景令牌对终端用户可见，价值有限；ALLOW_TARGETS 才是最有效的收紧手段。
AUTH_TOKEN=

# 显式确认公网匿名开放。ALLOW_TARGETS 与 AUTH_TOKEN 都为空时，
# 进程会拒绝启动，除非置 1。deploy.sh 会在这种情况下自动置 1 并警告。
PUBLIC_MODE=

# ---- 流量兜底（不依赖调用方身份，为带宽账单保底）----

# 全局请求速率上限（令牌桶），超出返回 429。
RATE_LIMIT_RPS=10

# 进程累计出口字节上限，达到后新请求返回 503。进程重启即重置，不是每日配额。
# 默认 10 GiB。统计请求体与响应体两个方向。
MAX_EGRESS_BYTES=10737418240

# ---- 其他 ----

# 覆盖镜像版本。备用源：ghcr.io/kurisu994/any-proxy:0.1.0
ANY_PROXY_IMAGE=kurisu003/any-proxy:0.1.0
